{
  "name": "garage-u-ilnura",
  "version": "1.3.0",
  "description": "Гараж у Ильнура — хоррор от первого лица",
  "author": "Azamat Nurgalin",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare-game": "node prepare.cjs",
    "dist": "npm run prepare-game && electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.azamat.garage",
    "productName": "Garage u Ilnura",
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.cjs",
      "game/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Garage-u-Ilnura-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "three": "^0.128.0"
  }
}
